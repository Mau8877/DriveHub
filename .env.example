# ==========================================
# INFRAESTRUCTURA GLOBAL
# ==========================================

# ---------------------------------------
# POSTGRESQL
# ---------------------------------------
POSTGRES_DB=app_db
POSTGRES_USER=app_admin
POSTGRES_PASSWORD=app_local_pass_123

# ---------------------------------------
# MINIO (S3 Local)
# ---------------------------------------
# MinIO exige MINIO_ROOT_USER >= 3 caracteres y MINIO_ROOT_PASSWORD >= 8 caracteres,
# si no el contenedor termina en "exited (1)".
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=minio_local_pass_123

# Puerto del HOST donde se publica Postgres (por defecto 5432). Cambialo si ya tenes un Postgres local en 5432.
# POSTGRES_HOST_PORT=5433
