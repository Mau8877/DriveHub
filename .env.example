# ==========================================
# INFRAESTRUCTURA GLOBAL (docker-compose.yml)
# ==========================================

# ---------------------------------------
# PERFILES DE DOCKER COMPOSE
# ---------------------------------------
# La infraestructura (Postgres, Mongo, DynamoDB, RabbitMQ) siempre arranca.
# Estos perfiles agregan: backend (8 microservicios), frontend (shell + remotos + nginx) y extras (MinIO para las fotos de perfil y otros servicios opcionales). Dejarlo vacío para levantar solo la infra.
COMPOSE_PROFILES=backend,frontend,extras

# ---------------------------------------
# POSTGRESQL (Identidad, Escuela, Pagos)
# ---------------------------------------
# Superusuario del contenedor (solo para administrar, ningún servicio lo usa).
POSTGRES_USER=drivehub_admin
POSTGRES_PASSWORD=drivehub_local_pass_123
# Una base y un usuario por microservicio (infrastructure/postgres/init/01-crear-bases.sh).
# El usuario se llama igual que la base: identidad, escuela, pagos.
IDENTIDAD_DB_PASSWORD=identidad_local_pass_123
ESCUELA_DB_PASSWORD=escuela_local_pass_123
PAGOS_DB_PASSWORD=pagos_local_pass_123
# Puerto del HOST donde se publica Postgres (por defecto 5432). Cambialo si ya tenés un Postgres local en 5432.
# POSTGRES_HOST_PORT=5433

# ---------------------------------------
# RABBITMQ (bus de eventos)
# ---------------------------------------
RABBITMQ_DEFAULT_USER=drivehub
RABBITMQ_DEFAULT_PASS=drivehub_local_pass_123

# ---------------------------------------
# DYNAMODB LOCAL (Notificaciones, Asistente IA)
# ---------------------------------------
# dynamodb-local no valida credenciales, pero el SDK de AWS exige que existan.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local

# ---------------------------------------
# CONTENIDO (Laravel)
# ---------------------------------------
# Generar con: php artisan key:generate --show (dentro de projects/backend/contenido)
CONTENIDO_APP_KEY=base64:ZHJpdmVodWItY29udGVuaWRvLWxvY2FsLWtleS0zMmI=

# ---------------------------------------
# MINIO (S3 local)
# ---------------------------------------
# MinIO exige MINIO_ROOT_USER >= 3 caracteres y MINIO_ROOT_PASSWORD >= 8 caracteres,
# si no el contenedor termina en "exited (1)".
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=minio_local_pass_123
# URL con la que el navegador o el teléfono alcanzan MinIO (no la de Docker): Identidad
# firma con ella las URLs de lectura de las fotos de perfil (CU06). En el navegador de
# la PC basta localhost; para el emulador o un teléfono real va la IP de la PC en la red,
# por ejemplo http://192.168.1.50:9000
MINIO_PUBLIC_URL=http://localhost:9000

# ---------------------------------------
# CORREO (Identidad: verificar correo y recuperar contraseña)
# ---------------------------------------
# En desarrollo los correos van a Mailpit (SMTP falso, bandeja en http://localhost:8025) y no hace
# falta tocar nada. Para enviar correos reales, apuntar estas variables a un SMTP de verdad
# (ej. SMTP_HOST=smtp.proveedor.com, SMTP_PORT=587, SMTP_USER y SMTP_PASSWORD): el código es el mismo.
# SMTP_HOST=drivehub-mailpit
# SMTP_PORT=1025
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=no-reply@drivehub.local
# Web a la que apuntan los enlaces de los correos (en producción, la URL pública del shell).
# APP_WEB_URL=http://localhost:4200

# ---------------------------------------
# CLOUDINARY (fotos de los autos, servicio Escuela)
# ---------------------------------------
# Se copian del panel de Cloudinary (Dashboard > API Keys). El API secret NO se commitea: va solo en tu .env.
# Sin estas variables la app funciona, pero no se pueden subir fotos nuevas (las de la seed se ven igual).
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# ---------------------------------------
# UBICACION (Identidad: dirección a partir del punto del mapa, CU08a)
# ---------------------------------------
# Por defecto se usa Nominatim de OpenStreetMap (gratis, sin clave). Su servidor público pide un User-Agent
# identificable (con un contacto) y no más de 1 consulta por segundo: sirve para desarrollo; en producción,
# una instancia propia.
# GEOCODIFICACION_URL=https://nominatim.openstreetmap.org
# GEOCODIFICACION_USER_AGENT=DriveHub/1.0 (contacto@tuescuela.com)

# ---------------------------------------
# PAGOS: pasarela de pago, Stripe (CU26)
# ---------------------------------------
# Claves de la cuenta de Stripe (en modo de prueba empiezan con sk_test_ y whsec_). NUNCA se commitean.
# Sin clave el servicio arranca igual y responde 503 al intentar cobrar.
STRIPE_SECRET_KEY=
# Secreto de la firma de los avisos de Stripe (CU27). En local: agrega `stripe` a COMPOSE_PROFILES, levanta con
# `docker compose up -d stripe-cli`, copia el `whsec_...` que imprime `docker compose logs stripe-cli` y reinicia pagos.
# En un despliegue: el del webhook creado en el panel de Stripe.
STRIPE_WEBHOOK_SECRET=
# Pagina publica a la que vuelve el estudiante al terminar (o cancelar) el pago: la sirve el servicio pagos por el
# gateway y la abre el NAVEGADOR DEL TELEFONO, asi que tiene que ser alcanzable desde el telefono. Cambia con cada
# entorno: en el emulador de Android `localhost` es el propio emulador (usa http://10.0.2.2:8080/...), en un
# telefono real la IP de tu maquina, y en produccion el dominio publico con https.
# OBLIGATORIA: sin ella el servicio pagos no arranca.
PAGOS_URL_RETORNO=http://10.0.2.2:8080/api/v1/pagos/retorno
# Enlace con el que esa pagina abre la app movil. Su esquema (`drivehub`, host `app`) esta declarado en el
# AndroidManifest.xml y el Info.plist de la app. OBLIGATORIA.
PAGOS_ENLACE_APP=drivehub://app/payments/return
# Credencial de SERVICIO con la que Academico se identifica ante las rutas internas de Pagos (/internal/**, CU44),
# en el header X-Service-Key. Pagos y Academico reciben el MISMO valor. Tiene que ser aleatoria y larga, distinta
# en cada entorno, y NUNCA se commitea con un valor real. Para generarla:  openssl rand -hex 32
# OBLIGATORIA: sin ella pagos y academico no arrancan (y Pagos rechaza toda llamada interna sin credencial).
PAGOS_CREDENCIAL_ACADEMICO=
# Credencial de SERVICIO con la que los demas servicios piden un aviso a Notificaciones por su ruta interna
# (/internal/v1/notificaciones, CU36), en el header X-Service-Key. Aleatoria y larga, distinta en cada entorno, y
# NUNCA se commitea con un valor real:  openssl rand -hex 32
# Sin ella Notificaciones rechaza toda llamada interna (los avisos por RabbitMQ no la necesitan) y pagos y academico
# no mandan ningun aviso (reciben el MISMO valor que notificaciones).
NOTIFICACIONES_CREDENCIAL_SERVICIOS=
# GraphQL de Notificaciones (CU45, POST /api/v1/graphql, al lado de REST). Opcionales: sin valor, GraphQL queda
# encendido y con la introspección (ver el esquema) encendida solo en este compose de desarrollo.
# GRAPHQL_ENABLED=false lo apaga y deja el servicio solo con REST.
# GRAPHQL_ENABLED=true
# GRAPHQL_INTROSPECTION=true
# Push (CU36): cuenta de servicio de Firebase (Firebase > Configuracion > Cuentas de servicio > Generar clave privada).
# Se pega el JSON entero en UNA linea, o la ruta a un archivo dentro del contenedor. NUNCA se commitea con un valor real.
# Vacia, el correo y la bandeja funcionan y el push queda registrado como FALLIDA.
FIREBASE_CREDENCIALES=
# Bolivianos por dolar (para fijar cuanto se le cobra al estudiante en dolares y mostrar el costo de un plan).
# No hay servicio externo ni valor por defecto en el codigo: se cambia aca. OBLIGATORIA y mayor a 0.
TIPO_CAMBIO_BS_USD=11.77

# ---------------------------------------
# CHAT DE WHATSAPP (CU47 a CU49): Identidad, n8n y Asistente IA
# ---------------------------------------
# Credencial con la que n8n pasa por las rutas internas de Identidad (/internal/**, header X-Service-Key).
# Vacia, Identidad rechaza todas esas rutas. Genera una larga y aleatoria; NUNCA se commitea con un valor real.
IDENTIDAD_CREDENCIAL_N8N=
# Clave del HMAC con el que Identidad guarda el numero, el correo y el codigo (nunca en claro). Propia y secreta.
WHATSAPP_HASH_SECRET=whatsapp_hash_local_secret_123
# Escuela del chat (la de la semilla del proyecto): el numero de WhatsApp es de una sola escuela.
WHATSAPP_ESCUELA_CODIGO=0198f0a0-0000-7000-8000-000000000001

# ---------------------------------------
# N8N + WHATSAPP + OPENROUTER (CU47 a CU49): perfil `whatsapp` de Docker Compose
# ---------------------------------------
# Para levantarlo: agrega `whatsapp` a COMPOSE_PROFILES. Guia paso a paso en infrastructure/n8n/README.md.
# Clave con la que n8n cifra sus credenciales guardadas. Larga, aleatoria y NO se cambia despues (si cambia,
# n8n no puede leer las credenciales ya guardadas).
N8N_ENCRYPTION_KEY=
# URL de n8n. Con WAHA no hace falta tunel: WAHA y n8n se hablan por la red de Docker.
WEBHOOK_URL=http://localhost:5678/
# WAHA (WhatsApp HTTP API, contenedor `waha`): enlaza un WhatsApp escaneando un QR. NO es la API oficial: Meta puede
# bloquear el numero, asi que usa un numero SECUNDARIO. Panel y QR en http://localhost:3010/dashboard.
# Clave de la API de WAHA (header X-Api-Key). Larga y aleatoria; NUNCA se commitea:  openssl rand -hex 32
WAHA_API_KEY=
# Clave con la que WAHA firma cada mensaje que le entrega a n8n (HMAC-SHA512). Larga y aleatoria; NUNCA se commitea.
WAHA_HMAC_KEY=
# Usuario y contrasena del panel de WAHA.
WAHA_DASHBOARD_USERNAME=admin
WAHA_DASHBOARD_PASSWORD=admin
# (Opcional) Solo atiende a estos numeros (solo digitos, con el codigo de pais, separados por comas): 59171234567,59172345678.
# Vacio atiende a cualquiera que escriba. Recomendado en las pruebas, sobre todo si el numero enlazado es el tuyo.
WHATSAPP_NUMEROS_PERMITIDOS=
# Clave de OpenRouter (modelo del agente). NUNCA se commitea.
OPENROUTER_API_KEY=
# Modelo de OpenRouter para el agente. Tiene que soportar llamadas a herramientas (tool calling).
OPENROUTER_MODEL=openai/gpt-4o-mini
# (Opcional) Modelo del clasificador de confirmaciones («sí», «dale»...). Vacio usa OPENROUTER_MODEL; puede ser uno mas barato.
OPENROUTER_MODEL_CLASIFICADOR=
