# ==========================================
# INFRAESTRUCTURA GLOBAL (docker-compose.yml)
# ==========================================

# ---------------------------------------
# PERFILES DE DOCKER COMPOSE
# ---------------------------------------
# La infraestructura (Postgres, Mongo, DynamoDB, RabbitMQ, MinIO) siempre arranca.
# Estos perfiles agregan: backend (8 microservicios), frontend (shell + remotos + nginx),
# observabilidad (Prometheus + Grafana). Dejarlo vacío para levantar solo la infra.
COMPOSE_PROFILES=backend,frontend,observabilidad

# ---------------------------------------
# POSTGRESQL (Identidad, Escuela, Pagos)
# ---------------------------------------
# Superusuario del contenedor (solo para administrar, ningún servicio lo usa).
POSTGRES_USER=drivehub_admin
POSTGRES_PASSWORD=drivehub_local_pass_123
# Una base y un usuario por microservicio (infrastructure/postgres/init/01-crear-bases.sh).
# El usuario se llama igual que la base: identidad, escuela, pagos.
IDENTIDAD_DB_PASSWORD=identidad_local_pass_123
ESCUELA_DB_PASSWORD=escuela_local_pass_123
PAGOS_DB_PASSWORD=pagos_local_pass_123
# Puerto del HOST donde se publica Postgres (por defecto 5432). Cambialo si ya tenés un Postgres local en 5432.
# POSTGRES_HOST_PORT=5433

# ---------------------------------------
# RABBITMQ (bus de eventos)
# ---------------------------------------
RABBITMQ_DEFAULT_USER=drivehub
RABBITMQ_DEFAULT_PASS=drivehub_local_pass_123

# ---------------------------------------
# DYNAMODB LOCAL (Notificaciones, Asistente IA)
# ---------------------------------------
# dynamodb-local no valida credenciales, pero el SDK de AWS exige que existan.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local

# ---------------------------------------
# CONTENIDO (Laravel)
# ---------------------------------------
# Generar con: php artisan key:generate --show (dentro de projects/backend/contenido)
CONTENIDO_APP_KEY=base64:ZHJpdmVodWItY29udGVuaWRvLWxvY2FsLWtleS0zMmI=

# ---------------------------------------
# MINIO (S3 local)
# ---------------------------------------
# MinIO exige MINIO_ROOT_USER >= 3 caracteres y MINIO_ROOT_PASSWORD >= 8 caracteres,
# si no el contenedor termina en "exited (1)".
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=minio_local_pass_123
