# Solo se usan cuando el remoto corre SUELTO (pnpm dev en el puerto 4206).
# Dentro del shell, la URL de la API y el token los entrega el shell al
# montar el remoto (ver src/mount.tsx).

# URL base de la API (el API Gateway)
VITE_API_BASE_URL=http://localhost:8080/api/v1

# Logging de requests HTTP en consola (ver src/store/createBaseApi.ts).
# true/false -- apagado por default, no queremos loguear en producción.
VITE_ENABLE_API_LOGS=false
