# URL base de la API del backend.
# - Emulador Android: 10.0.2.2 apunta al localhost del host (no "localhost").
# - Emulador iOS / dispositivo físico en la misma red: usar la IP real de tu
#   máquina en vez de 10.0.2.2.
API_BASE_URL=http://10.0.2.2:8080/api/v1

# Logging de requests HTTP en consola (ver core/network/api_client.dart).
# true/false -- apagado por default, no queremos loguear en producción.
ENABLE_API_LOGS=false
