# Configuración de la app para la NUBE (sin secretos: se commitea). La empaqueta el build de release:
#   flutter build apk --release --dart-define=DH_ENV=.env.produccion
# La dirección es solo la SUGERIDA en la pantalla «Conecta tu app» (CU51): la persona la puede cambiar.
# Sale del balanceador de GCP (sslip.io, ver docs/DESPLIEGUE_KUBERNETES.md); si esa IP cambia, se cambia acá.
API_BASE_URL=https://drivehub.34-11-98-15.sslip.io/api/v1
ENABLE_API_LOGS=false
NOTIFICACIONES_TRANSPORTE=graphql
# De dónde la app descarga, la primera vez que se usa, los modelos del asistente de voz (CU50, ~370 MB): en
# S3 de AWS, carpeta pública modelos-ia/ del bucket amz-drivehub. Sin esta variable (desarrollo) se copian con `adb push`.
MODELOS_IA_URL=https://s3.us-east-1.amazonaws.com/amz-drivehub/modelos-ia
