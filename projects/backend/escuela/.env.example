# ==========================================
# MICROSERVICIO ESCUELA - variables para correrlo FUERA de Docker
# ==========================================
# Dentro de docker-compose estos valores los pisa el environment del servicio.

SERVER_PORT=8082

# Base de datos propia (PostgreSQL)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/escuela
SPRING_DATASOURCE_USERNAME=escuela
SPRING_DATASOURCE_PASSWORD=escuela_local_pass_123

# Bus de eventos (RabbitMQ)
SPRING_RABBITMQ_HOST=localhost
SPRING_RABBITMQ_USERNAME=drivehub
SPRING_RABBITMQ_PASSWORD=drivehub_local_pass_123

