# ==========================================
# MICROSERVICIO ASISTENTE IA - variables para correrlo FUERA de Docker
# ==========================================
# Dentro de docker-compose estos valores los pisa el environment del servicio.

PORT=8087

# DynamoDB (dynamodb-local en desarrollo; vacío en AWS real)
DYNAMODB_ENDPOINT=http://localhost:8000
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local
# Crea las tablas que falten al arrancar (false en AWS real)
DYNAMODB_CREAR_TABLAS=true

# Bus de eventos (RabbitMQ)
RABBITMQ_URL=amqp://drivehub:drivehub_local_pass_123@localhost:5672

# Almacenamiento (MinIO): fotos del tablero en el bucket drivehub-asistente-ia
MINIO_URL=http://localhost:9000
MINIO_ACCESS_KEY=minio_admin
MINIO_SECRET_KEY=minio_local_pass_123
MINIO_PUBLIC_URL=http://localhost:9000

# Identidad: sus claves públicas (JWKS) validan el JWT de cada petición
IDENTIDAD_URL=http://localhost:8081
