# ==========================================
# MICROSERVICIO NOTIFICACIONES - variables para correrlo FUERA de Docker
# ==========================================
# Dentro de docker-compose estos valores los pisa el environment del servicio.

PORT=8086

# DynamoDB (dynamodb-local en desarrollo; vacío en AWS real)
DYNAMODB_ENDPOINT=http://localhost:8000
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local
# Crea las tablas que falten al arrancar (false en AWS real)
DYNAMODB_CREAR_TABLAS=true

# Bus de eventos (RabbitMQ)
RABBITMQ_URL=amqp://drivehub:drivehub_local_pass_123@localhost:5672

# Claves publicas de Identidad (JWKS) para validar el JWT de quien registra su dispositivo
IDENTIDAD_URL=http://localhost:8081
JWT_EMISOR=drivehub-identidad

# Correo (en desarrollo, Mailpit: bandeja en http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@drivehub.local

# Push: cuenta de servicio de Firebase (JSON en una linea o ruta a un archivo). Vacia, el push queda FALLIDA.
FIREBASE_CREDENCIALES=

# Credencial de servicio de /internal/v1/notificaciones (header X-Service-Key). Sin ella se rechaza todo.
NOTIFICACIONES_CREDENCIAL_SERVICIOS=
