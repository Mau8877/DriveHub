{
  "name": "notificaciones",
  "version": "0.0.1",
  "description": "Microservicio Notificaciones de DriveHub: historial, preferencias y dispositivos push (NestJS, capas, DynamoDB)",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
