# ==========================================
# MICROSERVICIO IDENTIDAD - variables para correrlo FUERA de Docker
# ==========================================
# Dentro de docker-compose estos valores los pisa el environment del servicio.

SERVER_PORT=8081

# Base de datos propia (PostgreSQL)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/identidad
SPRING_DATASOURCE_USERNAME=identidad
SPRING_DATASOURCE_PASSWORD=identidad_local_pass_123

# Bus de eventos (RabbitMQ)
SPRING_RABBITMQ_HOST=localhost
SPRING_RABBITMQ_USERNAME=drivehub
SPRING_RABBITMQ_PASSWORD=drivehub_local_pass_123

# Almacenamiento (MinIO)
MINIO_URL=http://localhost:9000
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=minio_local_pass_123
