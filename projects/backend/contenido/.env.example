# ==========================================
# MICROSERVICIO CONTENIDO - variables para correrlo FUERA de Docker
# ==========================================
# Dentro de docker-compose estos valores los pisa el environment del servicio.

APP_NAME=contenido
APP_ENV=local
# Generar con: php artisan key:generate
APP_KEY=
APP_DEBUG=true

# Sin sesiones, caché ni colas en base de datos: API stateless.
CACHE_STORE=array
SESSION_DRIVER=array
QUEUE_CONNECTION=sync

LOG_CHANNEL=json
LOG_LEVEL=info

# Base de datos propia (MongoDB, replica set rs0)
DB_CONNECTION=mongodb
MONGODB_URI=mongodb://localhost:27017/contenido?directConnection=true
MONGODB_DATABASE=contenido

# Bus de eventos (RabbitMQ)
RABBITMQ_HOST=localhost
RABBITMQ_USER=drivehub
RABBITMQ_PASSWORD=drivehub_local_pass_123

# Almacenamiento (MinIO): manuales y tutoriales en el bucket drivehub-contenido.
# MINIO_URL es la dirección con la que este servicio sube; MINIO_PUBLIC_URL, la que usa el navegador para abrir los archivos.
MINIO_URL=http://localhost:9000
MINIO_PUBLIC_URL=http://localhost:9000
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=minio_local_pass_123

# Claves públicas de Identidad (JWKS) para validar el JWT
IDENTIDAD_URL=http://localhost:8081
