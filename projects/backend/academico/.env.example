# ==========================================
# MICROSERVICIO ACADEMICO - variables para correrlo FUERA de Docker
# ==========================================
# Dentro de docker-compose estos valores los pisa el environment del servicio.

SERVER_PORT=8084

# Base de datos propia (MongoDB, replica set rs0)
SPRING_MONGODB_URI=mongodb://localhost:27017/academico?directConnection=true

# Bus de eventos (RabbitMQ)
SPRING_RABBITMQ_HOST=localhost
SPRING_RABBITMQ_USERNAME=drivehub
SPRING_RABBITMQ_PASSWORD=drivehub_local_pass_123
