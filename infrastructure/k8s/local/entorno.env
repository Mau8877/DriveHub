# Variables no secretas del entorno LOCAL (Kubernetes de Docker Desktop, entrada por http://localhost).
# Cada nube tendrá su propio archivo con su dominio.
APP_WEB_URL=http://localhost
CORS_ALLOWED_ORIGINS=http://localhost
# Cookie del refresh token sin Secure: en local la web va por http.
APP_COOKIES_SECURE=false
PAGOS_URL_RETORNO=http://localhost/api/v1/pagos/retorno
PAGOS_ENLACE_APP=drivehub://app/payments/return
TIPO_CAMBIO_BS_USD=11.77
# Con este host firman las URLs de los archivos (fotos de perfil, manuales): el navegador lo resuelve a 127.0.0.1.
MINIO_PUBLIC_URL=http://archivos.localhost
MINIO_BUCKETS=identidad pagos contenido asistente-ia
MINIO_URL=http://minio:9000
MINIO_ENDPOINT=http://minio:9000
# DynamoDB local (en la nube no se define el endpoint y el SDK usa el de la región).
DYNAMODB_ENDPOINT=http://dynamodb:8000
DYNAMODB_CREAR_TABLAS=true
AWS_REGION=us-east-1
# Perfil dev de Spring: solo activa las semillas (Super Admin, escuela, instructores, planes, horarios...) y que
# Identidad genere su par de claves JWT al arrancar. Así el clúster local tiene los mismos datos que docker-compose.
# ! Nunca en la nube: las semillas crean cuentas con la contraseña de desarrollo.
SPRING_PROFILES_ACTIVE=dev
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM=no-reply@drivehub.local
GEOCODIFICACION_URL=https://nominatim.openstreetmap.org
GEOCODIFICACION_USER_AGENT=DriveHub/1.0
GRAPHQL_INTROSPECTION=false
NODE_ENV=production
APP_ENV=production
APP_DEBUG=false
