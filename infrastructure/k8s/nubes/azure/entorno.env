# Variables no secretas de Azure (AKS). La web pública vive en GCP (drivehub.<IP de GCP>.sslip.io).
APP_WEB_URL=https://drivehub.34-11-98-15.sslip.io
PAGOS_URL_RETORNO=https://drivehub.34-11-98-15.sslip.io/api/v1/pagos/retorno
PAGOS_ENLACE_APP=drivehub://app/payments/return
TIPO_CAMBIO_BS_USD=11.77
# Archivos en S3 de AWS: bucket amz-drivehub (us-east-1), una carpeta por servicio. Las claves del usuario IAM van en
# el secreto drivehub-secretos como MINIO_ROOT_USER (access key) y MINIO_ROOT_PASSWORD (secret key).
MINIO_URL=https://s3.us-east-1.amazonaws.com
MINIO_ENDPOINT=https://s3.us-east-1.amazonaws.com
MINIO_PUBLIC_URL=https://s3.us-east-1.amazonaws.com
MINIO_BUCKET_COMPROBANTES=amz-drivehub
# ! Perfil dev SOLO para la demostración: activa las semillas (planes de horas, horarios, preguntas, simulacros),
# ! que usan los mismos códigos fijos de escuela e instructor que las semillas de identidad y escuela (GCP).
SPRING_PROFILES_ACTIVE=dev
