# Variables no secretas de Google Cloud (GKE). Sin dominio propio: sslip.io resuelve <algo>.<IP>.sslip.io a esa IP,
# así que la IP pública del balanceador de Traefik hace de dominio. IP_PUBLICA: completar con esa IP (con guiones).
APP_WEB_URL=https://drivehub.34-11-98-15.sslip.io
CORS_ALLOWED_ORIGINS=https://drivehub.34-11-98-15.sslip.io
# HTTPS con Let's Encrypt (cert-manager): la cookie del refresh token viaja solo por HTTPS.
APP_COOKIES_SECURE=true
# Archivos en S3 de AWS: bucket amz-drivehub (us-east-1), una carpeta por servicio. Las claves del usuario IAM van en
# el secreto drivehub-secretos como MINIO_ROOT_USER (access key) y MINIO_ROOT_PASSWORD (secret key).
MINIO_URL=https://s3.us-east-1.amazonaws.com
MINIO_ENDPOINT=https://s3.us-east-1.amazonaws.com
MINIO_PUBLIC_URL=https://s3.us-east-1.amazonaws.com
APP_MINIO_BUCKETNAME=amz-drivehub
GEOCODIFICACION_URL=https://nominatim.openstreetmap.org
GEOCODIFICACION_USER_AGENT=DriveHub/1.0
# ! Perfil dev SOLO para la demostración: activa las semillas (Super Admin, escuela, instructores, estudiantes) con
# ! la contraseña de desarrollo. Las claves JWT sí son propias (secreto drivehub-secretos). Se quita al terminar la demo.
SPRING_PROFILES_ACTIVE=dev
# Correo real: Gmail con contraseña de aplicación (SMTP_USER y SMTP_PASSWORD en el secreto drivehub-secretos).
# Gmail reemplaza el remitente por la cuenta autenticada; SMTP_FROM queda como nombre de respaldo.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_FROM=no-reply@drivehub.demo
# Gmail exige STARTTLS en el puerto 587 y JavaMail no lo activa solo (identidad no lo trae en su configuración).
SPRING_APPLICATION_JSON={"spring":{"mail":{"properties":{"mail.smtp.starttls.enable":"true","mail.smtp.starttls.required":"true"}}}}
